# ====================================================================
# AmazonAffiliateBot - Environment Configuration Template
# Copy this file to .env and configure credentials for live publishing handoff.
# ====================================================================

# Global Mode: true = dry run simulation (default), false = live publishing
DRY_RUN=true

# --------------------------------------------------------------------
# 1. Meta Graph API Credentials (Facebook & Instagram)
#    Target Facebook Account : LifeModeHQ
#    Target Instagram Account: lifemodehq
# --------------------------------------------------------------------
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# --------------------------------------------------------------------
# 2. Pinterest API v5 Credentials
#    Target Account: dailyideasforyou
#    Target Board  : Shopping ideas
# --------------------------------------------------------------------
PINTEREST_ACCESS_TOKEN=
# LifeModeHQ OAuth token (authorize with scripts/authorize_pinterest_lifemodehq.py)
PINTEREST_LIFEMODEHQ_ACCESS_TOKEN=
# Pinterest app secret stays local only; never commit it.
PINTEREST_APP_SECRET=
# Registered callback used by the local helper.
PINTEREST_OAUTH_REDIRECT_URI=http://localhost:8085/oauth/callback

# --------------------------------------------------------------------
# 3. Threads API Credentials
#    Target Account: lifemodehq
# --------------------------------------------------------------------
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# --------------------------------------------------------------------
# 4. Amazon Creators API product lookup (optional)
#    Keep client credentials only in the ignored local .env file.
#    Version 3.2 uses the EU Login with Amazon token endpoint.
# --------------------------------------------------------------------
AMAZON_CREATORS_API_CLIENT_ID=
AMAZON_CREATORS_API_CLIENT_SECRET=
AMAZON_CREATORS_API_VERSION=3.2
AMAZON_CREATORS_API_MARKETPLACE=www.amazon.co.uk

# --------------------------------------------------------------------
# 5. Dashboard automation
# --------------------------------------------------------------------
# After a successful product import the dashboard synchronizes the accepted
# products (queue + content packages + batch history) with GitHub so the
# scheduled GitHub Actions workflow can publish them.
# 1 (default) = automatic synchronization is enabled.
# 0           = opt out; no Git operation runs after an import.
AUTO_SYNC_AFTER_IMPORT=1
# --------------------------------------------------------------------
# 6. Cloudflare R2 Creative Asset Storage (Reused from LifeMode)
# --------------------------------------------------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=lifemode-assets
# R2_PUBLIC_BASE_URL=
